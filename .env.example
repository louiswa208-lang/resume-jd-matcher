# 复制这个文件为 .env.local,然后填入你自己的 key。
# .env.local 已被 .gitignore 忽略,不会进版本库,也不会被部署以外的任何人看到。
#
#   cp .env.example .env.local     (Git Bash)
#   copy .env.example .env.local   (cmd)
#
# DeepSeek API Key —— 从 https://platform.deepseek.com 的 API keys 页面获取
DEEPSEEK_API_KEY=

# 可选:模型名。默认 deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat

# 可选:每个 IP 每天允许的真实分析次数(不含点击示例)。默认 5
# DAILY_LIMIT_PER_IP=5
